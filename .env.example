# Frontend variables exposed by Vite must use the VITE_ prefix.
# The PDF API will be introduced in the next implementation phase.
VITE_API_BASE_URL=http://localhost:8000

# Backend settings (the values below are also the application defaults).
FRONTEND_ORIGIN=http://localhost:5173
MATERIALRAG_INDEX_PATH=data/chroma
MATERIALRAG_EMBEDDING_MODEL=BAAI/bge-m3
MATERIALRAG_EMBEDDING_BATCH_SIZE=32
MATERIALRAG_UPSERT_BATCH_SIZE=256
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash

# Optional OpenAI fallback:
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
